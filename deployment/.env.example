POSTGRES_DB=zeroon
POSTGRES_USER=zeroon
POSTGRES_PASSWORD=replace-with-a-random-database-password

REDIS_PASSWORD=replace-with-a-random-redis-password
ZEROON_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ZEROON_ADMIN_EMAILS=admin@example.com

LLM_BASE_URL=https://provider.example.com/v1
LLM_API_KEY=replace-with-provider-secret
ZEROON_LLM_MODEL=replace-with-approved-model
ZEROON_LLM_TEMPERATURE=0.2

ZEROON_SMTP_HOST=smtp.example.com
ZEROON_SMTP_PORT=587
ZEROON_SMTP_USERNAME=zeroon@example.com
ZEROON_SMTP_PASSWORD=replace-with-smtp-authorization-secret
ZEROON_EMAIL_FROM=zeroon@example.com
ZEROON_SMTP_SSL_ENABLED=false
ZEROON_SMTP_STARTTLS_ENABLED=true

ZEROON_EVIDENCE_INGESTION_ENABLED=true
ZEROON_EVIDENCE_NOTICE_VERSION=beta-evidence-v2
ZEROON_EVIDENCE_RETENTION_DAYS=180
